# OpenRouter API Key (Get your key at https://openrouter.ai/keys)
OPEN_ROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Vision Language Model on OpenRouter:
# - qwen/qwen-2.5-vl-7b-instruct (Fast & low cost)
# - qwen/qwen-2.5-vl-72b-instruct (Maximum document & table accuracy)
# - qwen/qwen-2.5-vl-72b-instruct:free (Free tier if available)
MODEL=qwen/qwen-2.5-vl-7b-instruct

# SQL Server (SSMS) Connection String for ItemMaster ItemNo lookup:
# Windows Authentication:
# SQL_SERVER_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=YOUR_SERVER_NAME;Database=YOUR_DB_NAME;Trusted_Connection=yes;"
# SQL Server Authentication:
# SQL_SERVER_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=YOUR_SERVER_NAME;Database=YOUR_DB_NAME;UID=sa;PWD=your_password;"
SQL_SERVER_CONNECTION_STRING=
#sql